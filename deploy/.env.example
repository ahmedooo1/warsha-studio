# Copy to deploy/.env on the server (chmod 600). Never commit deploy/.env.

# --- address of the workshop app, as the client and the workshop's devices open it
PUBLIC_URL=https://atelier.example.fr
# port on 127.0.0.1 the reverse proxy forwards to (pick one no other project uses)
APP_PORT=8090

# --- database (long random value: openssl rand -base64 32)
POSTGRES_PASSWORD=

# --- first start only: the owner account is created with this code, then remove it and restart
# (openssl rand -hex 24)
SETUP_TOKEN=

# --- sessions and client links
SESSION_DAYS=30
SHARE_DEFAULT_DAYS=30
SHARE_MAX_DAYS=180
TRASH_DAYS=30
KEEP_VERSIONS=50

# --- encrypted backups outside this server (restic). Example: Hetzner Storage Box over SFTP.
RESTIC_REPOSITORY=sftp:u000000@u000000.your-storagebox.de:/warsha
# the key that encrypts the backups. Keep a copy OUTSIDE the server (password manager, paper in the workshop):
# without it the backups cannot be read by anyone, including you.
RESTIC_PASSWORD=
# for SFTP: the private key file is mounted by deploy/backup (see docs/ATELIER.md). For Backblaze B2 instead:
# RESTIC_REPOSITORY=b2:bucket-name:warsha
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
BACKUP_HOUR=3
RESTORE_TEST_WEEKDAY=0

# --- optional design assistant (off by default; the workshop pays its own API use)
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=30
AI_MONTHLY_LIMIT=400
